{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KidKlatt/general-pi-wrappers/schema/game.schema.json",
  "title": "Pi game wrapper record (games/<slug>/game.json)",
  "description": "One file per game folder. Says which GOG products and installer builds the wrapper was made and tested against, and which version of the wrapper this is. Read by tools/build-catalog.py and, later, by the entry tool that matches a user's GOG library.",
  "type": "object",
  "required": ["schema_version", "slug", "short_id", "title", "wrapper", "gog_products"],
  "$defs": {
    "options": {
      "type": "array",
      "description": "README, \"Options\": checkboxes (flag) and drop-downs (choice) a tool such as general-pi-manager shows.",
      "items": { "oneOf": [ { "$ref": "#/$defs/flag" }, { "$ref": "#/$defs/choice" } ] }
    },
    "arg": { "type": "string", "pattern": "^--[a-z0-9-]+(=[A-Za-z0-9._:+-]+)?$" },
    "flag": {
      "type": "object",
      "required": ["option", "help"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "flag", "description": "Default when absent." },
        "option": { "type": "string", "pattern": "^--[a-z0-9-]+$", "description": "Added to the command line when ticked." },
        "label": { "type": "string", "description": "Checkbox text (short, e.g. \"FPS counter\"); help is used when absent." },
        "help": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["type", "id", "label", "default", "choices"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "choice" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Names the setting a tool remembers." },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "default": { "type": "string", "description": "The value of the choice used without options; its args are usually []." },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["value", "label", "args"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "label": { "type": "string" },
              "args": { "type": "array", "items": { "$ref": "#/$defs/arg" }, "description": "Added to the command line, in this order." }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Must equal the folder name under games/." },
    "short_id": { "type": "string", "pattern": "^[a-z0-9]{2,8}$", "description": "Pi folder ~/<short_id>, env prefix, tmux session, ssh alias <short_id>-pi." },
    "title": { "type": "string" },
    "wrapper": {
      "type": "object",
      "required": ["version", "status", "updated"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Semver of the wrapper itself. Bump on every merge to main that changes behaviour." },
        "status": { "enum": ["planned", "in-progress", "playable", "released", "retired"] },
        "phase": { "type": "string" },
        "updated": { "type": "string", "format": "date" },
        "public_repo": { "type": ["string", "null"] },
        "changelog": { "type": "string" }
      }
    },
    "gog_products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "title", "installer"],
        "properties": {
          "product_id": { "type": "string", "pattern": "^[0-9]+$", "description": "GOG gameId from goggame-<id>.info; also the id in the GOG API." },
          "title": { "type": "string" },
          "gog_build_id": { "type": ["string", "null"], "description": "buildId from goggame-<id>.info." },
          "gog_version": { "type": ["string", "null"], "description": "Version string GOG shows for the offline installer." },
          "installer": {
            "type": "object",
            "required": ["kind", "files"],
            "properties": {
              "kind": { "enum": ["offline", "galaxy"] },
              "gog_installer_build": { "type": ["string", "null"], "description": "The number in parentheses in GOG's installer file name." },
              "format": { "type": "string" },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "bytes", "sha256"],
                  "properties": {
                    "name": { "type": "string" },
                    "bytes": { "type": "integer" },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          },
          "main_exe": { "type": "string" },
          "launch_exe": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "Measured setups. Values come from the game's records, never estimated.",
      "items": {
        "type": "object",
        "required": ["device", "fps"],
        "properties": {
          "device": { "type": "string", "examples": ["pi4", "pi5"] },
          "ram_gb": { "type": ["number", "null"] },
          "resolution": { "type": "string" },
          "config": { "type": "string", "description": "default setup, or what else was needed for these numbers" },
          "fps": {
            "type": "object",
            "properties": {
              "typical": { "type": ["number", "null"], "description": "measured average in the main scene; if only a range was recorded, its lower end" },
              "low": { "type": ["number", "null"], "description": "measured minimum or the lower end of the worst case" },
              "scene": { "type": "string" }
            }
          },
          "rating": { "enum": [null, "smooth", "playable", "rough", "broken"], "description": "set by a person who played it; null until then" },
          "tested": { "type": "array", "items": { "type": "string" } },
          "result": { "type": "string", "description": "the original free-text result" }
        }
      }
    },
    "notes": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "description": "one line for the manager's library row" },
        "known_issues": { "type": "array", "items": { "type": "string" } },
        "tips": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["disk_gb"],
      "properties": {
        "os": { "type": "string" },
        "disk_gb": { "type": "number", "description": "free space the setup checks for" },
        "tested_on": { "type": "string" },
        "setup_time": { "type": ["string", "null"], "description": "only if recorded" }
      }
    },
    "stack": { "type": "object" },
    "depends_on": { "type": "array", "description": "Things on the Pi this wrapper uses that another game's setup installs." },
    "provides": { "type": "array" },
    "entry_points": {
      "type": "object",
      "properties": {
        "setup": { "type": ["string", "null"], "description": "scripts/pi/setup.sh when setup_interface is set" },
        "setup_interface": { "type": "integer", "enum": [1], "description": "The setup follows the standard interface (README, \"Setup interface\"), version 1. Absent: it does not (yet)." },
        "setup_options": { "$ref": "#/$defs/options", "description": "Options beyond the standard ones, shown in the install and update flow." },
        "play": { "type": ["string", "null"] },
        "play_options": { "$ref": "#/$defs/options", "description": "Every option play.sh takes, as the controls a tool shows next to Play." },
        "uninstall": { "type": ["string", "null"], "enum": ["scripts/pi/uninstall.sh", null], "description": "README, \"Setup interface\"; absent: no uninstaller, remove by hand" },
        "desktop": { "type": "array", "items": { "type": "string" }, "description": "Shortcut templates; Exec/Icon paths use @GAME_HOME@." }
      }
    }
  }
}
