# Play profile: what play.sh and the desktop shortcuts run by default. Load after
# config/pi4-mtw-lazy.env and config/track-hangover.env.
# Full screen: no Wine virtual desktop (VDESK empty); play.sh sets the prefix key
# EmulateModeset=Y so Wine scales the 4:3 picture to the display. d3d9lazy shim (tools/d3d9lazy)
# as d3d9.dll, patched Mesa, WineD3D VideoMemorySize=512.
# Otherwise identical to config/profile-window.env. Source: workshop record, experiments 131-139.
VDESK=
GAME_ARGS=
WINEDLLOVERRIDES="mscoree=;winegstreamer=;d3d9=n,b"
LD_LIBRARY_PATH=${MTW_HOME:-$HOME/mtw}/mesa-patched/lib/aarch64-linux-gnu
__EGL_VENDOR_LIBRARY_FILENAMES=${MTW_HOME:-$HOME/mtw}/mesa-patched/share/glvnd/egl_vendor.d/50_mesa.json
LIBGL_DRIVERS_PATH=${MTW_HOME:-$HOME/mtw}/mesa-patched/lib/aarch64-linux-gnu/dri
GBM_BACKENDS_PATH=${MTW_HOME:-$HOME/mtw}/mesa-patched/lib/aarch64-linux-gnu/gbm
D3D9LAZY_LOG=1
WINE_D3D_CONFIG="VideoMemorySize=512"
