# Window profile: play.sh --window. Load after config/pi4-mtw-lazy.env and config/track-hangover.env.
# The game unscaled in a 1024x768 Wine desktop window, the configuration the tests were
# validated with. d3d9lazy shim (tools/d3d9lazy) as d3d9.dll: defers the game's full-frame
# render-target locks until the game actually touches the pixels. Patched Mesa, WineD3D
# VideoMemorySize=512. Source: workshop record, experiment 116.
VDESK=1024x768
GAME_ARGS=
WINEDLLOVERRIDES="mscoree=;winegstreamer=;d3d9=n,b"
LD_LIBRARY_PATH=${MTW_HOME:-$HOME/mtw}/mesa-patched/lib/aarch64-linux-gnu
__EGL_VENDOR_LIBRARY_FILENAMES=${MTW_HOME:-$HOME/mtw}/mesa-patched/share/glvnd/egl_vendor.d/50_mesa.json
LIBGL_DRIVERS_PATH=${MTW_HOME:-$HOME/mtw}/mesa-patched/lib/aarch64-linux-gnu/dri
GBM_BACKENDS_PATH=${MTW_HOME:-$HOME/mtw}/mesa-patched/lib/aarch64-linux-gnu/gbm
D3D9LAZY_LOG=1
WINE_D3D_CONFIG="VideoMemorySize=512"
