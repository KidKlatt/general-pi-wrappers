# Pi 4 settings for the isolated game copy that carries the d3d9lazy shim (tools/d3d9lazy).
# Paths are relative to ~/mtw unless absolute.
DEVICE=pi4
DISPLAY_NUM=:0
# labwc/Wayland desktop is running on the attached HDMI display.
# import (X11, ImageMagick) | grim (Wayland) | scrot (X11)
SHOT_TOOL=grim
# Path to the X authority file if the SSH session cannot open the display, e.g. /home/admin/.Xauthority
XAUTH=
GAME_DIR=game-lazy
# Main game executable, relative to GAME_DIR.
GAME_EXE=Medieval_TW.exe
TARGET_RES=1024x768
