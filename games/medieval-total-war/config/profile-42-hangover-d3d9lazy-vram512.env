# profile-38 plus WineD3D VideoMemorySize=512 (experiment 116). profile-30 plus the d3d9lazy shim (tools/d3d9lazy): defers the game's full-frame render-target
# locks until the game actually touches the pixels. Use with config/pi4-lazy.env.
VDESK=1024x768
GAME_ARGS=
WINEDLLOVERRIDES="mscoree=;winegstreamer=;d3d9=n,b"
LD_LIBRARY_PATH=$HOME/mtw/mesa-patched/lib/aarch64-linux-gnu
__EGL_VENDOR_LIBRARY_FILENAMES=$HOME/mtw/mesa-patched/share/glvnd/egl_vendor.d/50_mesa.json
LIBGL_DRIVERS_PATH=$HOME/mtw/mesa-patched/lib/aarch64-linux-gnu/dri
GBM_BACKENDS_PATH=$HOME/mtw/mesa-patched/lib/aarch64-linux-gnu/gbm
D3D9LAZY_LOG=1
WINE_D3D_CONFIG="VideoMemorySize=512"
