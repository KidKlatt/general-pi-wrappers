# Track A: Hangover (native ARM64 Wine with x86 emulator DLLs).
# Confirm the binary names and the back-end selection variable in the Hangover README
# before first use, and record the installed version here.
TRACK=hangover
TRACK_VERSION=11.16
# Hangover is either the system Wine in /usr (default) or a private copy in ~/mtw/hangover
# (setup-new-pi.sh --private-wine, for a Pi that already has another Wine). Full paths, so another
# Wine earlier in PATH (for example Pi-Apps' in /usr/local/bin) is never used by the game.
if [ -z "${HANGOVER_ROOT:-}" ]; then
  if [ -x "$HOME/mtw/hangover/usr/bin/wine" ]; then HANGOVER_ROOT=$HOME/mtw/hangover/usr; else HANGOVER_ROOT=/usr; fi
fi
WINE_CMD=$HANGOVER_ROOT/bin/wine
WINESERVER_CMD=$HANGOVER_ROOT/bin/wineserver
WINEPREFIX=$HOME/mtw/prefixes/hangover
WINEARCH=win64
# Current i386 emulator back-end (default without this line: wowbox64.dll).
HODLL=wowbox64.dll
