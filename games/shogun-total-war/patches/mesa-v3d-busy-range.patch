          */
         bool private;
+
+        /**
+         * Byte range that GPU jobs may read or write since the BO was last
+         * known idle. busy_end == 0 means empty. CPU writes outside this
+         * range cannot race with the GPU.
+         */
+        uint32_t busy_start;
+        uint32_t busy_end;
+        /**
+         * Set right before a relocation whose precise range was already
+         * added with v3d_bo_busy_add(), so that the following
+         * v3d_job_add_bo() does not mark the whole BO busy.
+         */
+        bool busy_hint;
 };
 
+static inline void
+v3d_bo_busy_reset(struct v3d_bo *bo)
+{
+        bo->busy_start = 0;
+        bo->busy_end = 0;
+        bo->busy_hint = false;
+}
+
+static inline void
+v3d_bo_busy_add(struct v3d_bo *bo, uint64_t start, uint64_t end)
+{
+        if (end > bo->size)
+                end = bo->size;
+        if (start >= end)
+                return;
+        if (bo->busy_end == 0) {
+                bo->busy_start = start;
+                bo->busy_end = end;
+        } else {
+                if (start < bo->busy_start)
+                        bo->busy_start = start;
+                if (end > bo->busy_end)
+                        bo->busy_end = end;
+        }
+}
+
+static inline bool
+v3d_bo_busy_intersects(const struct v3d_bo *bo, uint64_t start, uint64_t end)
+{
+        if (bo->busy_end == 0)
+                return false;
+        return (start > bo->busy_start ? start : bo->busy_start) <
+               (end < bo->busy_end ? end : bo->busy_end);
+}
+
