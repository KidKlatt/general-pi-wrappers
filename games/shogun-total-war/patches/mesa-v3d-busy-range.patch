+/* Record the byte ranges of the vertex buffers that this draw can read, so
+ * that CPU writes elsewhere in those buffers need not flush the job. Falls
+ * back to marking a whole buffer when the range is not cheaply known.
+ */
+static void
+v3d_track_draw_buffer_ranges(struct v3d_context *v3d,
+                             const struct pipe_draw_info *info,
+                             const struct pipe_draw_indirect_info *indirect,
+                             const struct pipe_draw_start_count_bias *draw)
+{
+        bool have_range = false;
+        int64_t min_v = 0, max_v = 0;
+
+        if (!(indirect && indirect->buffer)) {
+                if (!info->index_size) {
+                        min_v = draw->start;
+                        max_v = (int64_t)draw->start + draw->count - 1;
+                        have_range = true;
+                } else if (info->index_bounds_valid) {
+                        min_v = (int64_t)info->min_index + draw->index_bias;
+                        max_v = (int64_t)info->max_index + draw->index_bias;
+                        have_range = true;
+                } else if (!info->has_user_indices && info->index.resource &&
+                           draw->count <= 4096) {
+                        struct v3d_resource *irsc =
+                                v3d_resource(info->index.resource);
+                        const uint8_t *map =
+                                v3d_bo_map_unsynchronized(irsc->bo);
+                        uint64_t first = (uint64_t)draw->start * info->index_size;
+                        uint64_t last = first +
+                                (uint64_t)draw->count * info->index_size;
+                        if (map && last <= irsc->bo->size) {
+                                uint32_t lo = ~0u, hi = 0;
+                                bool any = false;
+                                for (unsigned i = 0; i < draw->count; i++) {
+                                        const uint8_t *p = map + first +
+                                                (uint64_t)i * info->index_size;
+                                        uint32_t idx;
+                                        if (info->index_size == 1)
+                                                idx = *p;
+                                        else if (info->index_size == 2)
+                                                idx = *(const uint16_t *)p;
+                                        else
+                                                idx = *(const uint32_t *)p;
+                                        if (info->primitive_restart &&
+                                            idx == info->restart_index)
+                                                continue;
+                                        if (idx < lo)
+                                                lo = idx;
+                                        if (idx > hi)
+                                                hi = idx;
+                                        any = true;
+                                }
+                                if (any) {
+                                        min_v = (int64_t)lo + draw->index_bias;
+                                        max_v = (int64_t)hi + draw->index_bias;
+                                        have_range = true;
+                                }
+                        }
+                }
+        }
+        if (min_v < 0 || max_v < min_v)
+                have_range = false;
+
+        struct v3d_vertex_stateobj *vtx = v3d->vtx;
+        for (int i = 0; vtx && i < vtx->num_elements; i++) {
+                struct pipe_vertex_element *elem = &vtx->pipe[i];
+                struct pipe_vertex_buffer *vb =
+                        &v3d->vertexbuf.vb[elem->vertex_buffer_index];
+                struct v3d_resource *rsc = v3d_resource(vb->buffer.resource);
+
+                if (!rsc)
+                        continue;
+
+                if (!have_range || elem->instance_divisor ||
+                    elem->src_stride == 0) {
+                        v3d_bo_busy_add(rsc->bo, 0, rsc->bo->size);
+                        continue;
+                }
+
+                uint64_t base = (uint64_t)vb->buffer_offset + elem->src_offset;
+                uint32_t elem_size =
+                        util_format_get_blocksize(elem->src_format);
+                v3d_bo_busy_add(rsc->bo,
+                                base + (uint64_t)min_v * elem->src_stride,
+                                base + (uint64_t)max_v * elem->src_stride +
+                                elem_size);
+        }
+}
