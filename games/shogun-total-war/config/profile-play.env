# Play profile: what play.sh and the desktop shortcuts run by default. Load after
# config/pi4-stw-lazy.env and config/track-box64.env.
# Full screen, no Wine desktop. Needs this project's winex11.so with the Xwayland mode patch
# (tools/winex11/apply-xwayland-modeset.py): the game's 800x600 / 640x480 modes become Xwayland
# emulated modes, and Xwayland scales the game window to the whole 1280x720 output. No registry
# setting needed. Otherwise identical to config/profile-window.env.
# Source: workshop record, experiment 58 (2026-11-18).
VDESK=
GAME_ARGS=
WINEDLLOVERRIDES="mscoree=;winegstreamer=;d3d9=n,b;dsound=n,b"
LD_LIBRARY_PATH=${STW_HOME:-$HOME/stw}/mesa-patched/lib/aarch64-linux-gnu
__EGL_VENDOR_LIBRARY_FILENAMES=${STW_HOME:-$HOME/stw}/mesa-patched/share/glvnd/egl_vendor.d/50_mesa.json
LIBGL_DRIVERS_PATH=${STW_HOME:-$HOME/stw}/mesa-patched/lib/aarch64-linux-gnu/dri
GBM_BACKENDS_PATH=${STW_HOME:-$HOME/stw}/mesa-patched/lib/aarch64-linux-gnu/gbm
D3D9LAZY_LOG=1
