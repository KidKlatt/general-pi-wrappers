# Track B: Box64 + x86-64 Wine 9.17 (WoW64 build), runner-up in MTW.
# Uses MTW's unpacked copies READ-ONLY (AGENTS.md rule 10): the binaries are only executed, never
# changed. The prefix and caches are this project's own, under ~/stw.
# If this track is chosen for good, unpack own copies under ~/stw and point these paths there.
TRACK=box64
TRACK_VERSION=box64-0.4.5-a46caf3_wine-9.17-stw-winex11
WINE_CMD="$HOME/mtw/box64/usr/local/bin/box64 $HOME/stw/wine-x64-9.17/bin/wine"
WINESERVER_CMD="$HOME/mtw/box64/usr/local/bin/box64 $HOME/stw/wine-x64-9.17/bin/wineserver"
WINEPREFIX=$HOME/stw/prefixes/box64
WINEDLLOVERRIDES=mscoree=
# Starting values recommended by the Box64 documentation for Pi 4/5.
MESA_GL_VERSION_OVERRIDE=3.2
BOX64_DYNAREC_STRONGMEM=1
BOX64_NOBANNER=1
BOX64_LD_LIBRARY_PATH=$HOME/mtw/box64/usr/lib/box64-x86_64-linux-gnu
# Own caches: never write into ~/mtw/cache.
BOX64_DYNACACHE_FOLDER=$HOME/stw/cache/box64
XDG_CACHE_HOME=$HOME/stw/cache
