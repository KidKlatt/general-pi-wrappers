# Track B (chosen): Box64 + x86-64 Wine 9.17 (WoW64 build). Everything is this project's own copy
# under ~/stw (2026-11-18): Box64 0.4.5 (built from source at a46caf3 by setup-new-pi.sh), Kron4ek's Wine 9.17 with
# the rebuilt winex11.so (tools/winex11), prefix and caches. Nothing runs from ~/mtw any more.
TRACK=box64
TRACK_VERSION=box64-0.4.5-a46caf3_wine-9.17-stw-winex11-xw
WINE_CMD="$HOME/stw/box64/usr/local/bin/box64 $HOME/stw/wine-x64-9.17/bin/wine"
WINESERVER_CMD="$HOME/stw/box64/usr/local/bin/box64 $HOME/stw/wine-x64-9.17/bin/wineserver"
WINEPREFIX=$HOME/stw/prefixes/box64
WINEDLLOVERRIDES=mscoree=
# Starting values recommended by the Box64 documentation for Pi 4/5.
MESA_GL_VERSION_OVERRIDE=3.2
BOX64_DYNAREC_STRONGMEM=1
BOX64_NOBANNER=1
BOX64_LD_LIBRARY_PATH=$HOME/stw/box64/usr/lib/box64-x86_64-linux-gnu
# Own caches: never write into ~/mtw/cache.
BOX64_DYNACACHE_FOLDER=$HOME/stw/cache/box64
XDG_CACHE_HOME=$HOME/stw/cache
