# Window profile: play.sh --window. Load after config/pi4-stw-lazy.env and config/track-box64.env.
# The game in an 800x600 Wine desktop window, as the test harness runs it. game-lazy holds this
# project's d3d9lazy build (d3d9.dll, draw gate) and its Wine 9.17 dsound.dll with a linear
# resampler (tools/dsound, builtin marker blanked). Fight 36.5 avg / 20.5 min FPS, deployed
# battle 32-38, menus 55-60. Source: workshop record, experiment 40 (2026-11-17).
VDESK=800x600
GAME_ARGS=
WINEDLLOVERRIDES="mscoree=;winegstreamer=;d3d9=n,b;dsound=n,b"
LD_LIBRARY_PATH=${STW_HOME:-$HOME/stw}/mesa-patched/lib/aarch64-linux-gnu
__EGL_VENDOR_LIBRARY_FILENAMES=${STW_HOME:-$HOME/stw}/mesa-patched/share/glvnd/egl_vendor.d/50_mesa.json
LIBGL_DRIVERS_PATH=${STW_HOME:-$HOME/stw}/mesa-patched/lib/aarch64-linux-gnu/dri
GBM_BACKENDS_PATH=${STW_HOME:-$HOME/stw}/mesa-patched/lib/aarch64-linux-gnu/gbm
D3D9LAZY_LOG=1
