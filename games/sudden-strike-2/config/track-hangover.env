# Track A: Hangover (native ARM64 Wine with x86 emulator DLLs).
# Hangover 11.16 is already installed system-wide on this Pi by the Total War project
# (packages hangover-wine, hangover-wowbox64, hangover-libarm64ecfex). That project depends on
# it: do not upgrade, downgrade or remove it (AGENTS.md rule 10).
TRACK=hangover
TRACK_VERSION=11.16
# Full paths, so another Wine earlier in PATH (for example Pi-Apps' in /usr/local/bin) is never
# used. A private copy in ~/ss2/hangover wins if one is ever unpacked there.
if [ -z "${HANGOVER_ROOT:-}" ]; then
  if [ -x "${SS2_HOME:-$HOME/ss2}/hangover/usr/bin/wine" ]; then HANGOVER_ROOT=${SS2_HOME:-$HOME/ss2}/hangover/usr; else HANGOVER_ROOT=/usr; fi
fi
WINE_CMD=$HANGOVER_ROOT/bin/wine
WINESERVER_CMD=$HANGOVER_ROOT/bin/wineserver
# This project's own prefix. Never point this at ~/mtw/prefixes.
WINEPREFIX=${SS2_HOME:-$HOME/ss2}/prefixes/hangover
WINEARCH=win64
# i386 emulator back-end. Hangover's own default is wowbox64.dll, but under it saving a game
# hangs forever (an access violation in the game's save code is never handed back to the game;
# ntdll loops in unwinding, experiments 13-17). FEX (package hangover-libwow64fex, already
# installed) saves and loads correctly and holds about 60 FPS (experiments 18-20).
# An HODLL already in the environment wins (e.g. HODLL=wowbox64.dll to compare).
HODLL=${HODLL:-libwow64fex.dll}
