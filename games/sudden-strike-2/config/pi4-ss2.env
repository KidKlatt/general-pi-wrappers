# Device + game settings: Pi 4, Sudden Strike 2. Fill the blanks in Phase 2.
# Paths are relative to ~/ss2 unless absolute.
DEVICE=pi4
GAME=ss2
DISPLAY_NUM=:0
# labwc/Wayland desktop on the attached HDMI display (verified by the Total War project and the
# 2026-11-16 probe). import (X11, ImageMagick) | grim (Wayland) | scrot (X11)
SHOT_TOOL=grim
# Path to the X authority file if the SSH session cannot open the display.
XAUTH=
GAME_DIR=game-ss2
# Main game executable, relative to GAME_DIR (GOG play task; it loads n2Menu_dll.dll and n2Game_Dll.dll).
GAME_EXE=game_exe.exe
# Reference image for the menu check: refs/<REF_NAME>.png
REF_NAME=ss2_main_menu
TARGET_RES=1024x768
