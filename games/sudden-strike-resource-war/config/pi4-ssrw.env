# Device + game settings: Pi 4, Sudden Strike: Resource War.
# Paths are relative to ~/ssrw unless absolute.
DEVICE=pi4
GAME=ssrw
DISPLAY_NUM=:0
# labwc/Wayland desktop on the attached HDMI display (all earlier projects). import (X11) | grim (Wayland) | scrot (X11)
SHOT_TOOL=grim
# Path to the X authority file if the SSH session cannot open the display.
XAUTH=
GAME_DIR=game
# Main game executable, relative to GAME_DIR (GOG play task; it loads n2Menu_dll.dll and n2Game_Dll.dll).
# Never put this name into a profile or label file name (the harness finds it with pgrep -f).
GAME_EXE=game_exe.exe
# Reference image for the menu check: refs/<REF_NAME>.png
REF_NAME=ssrw_main_menu
TARGET_RES=1024x768
