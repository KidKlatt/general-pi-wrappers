# Track A: Hangover (native ARM64 Wine with x86 emulator DLLs).
# Hangover 11.16 is installed system-wide on this Pi by the MTW project (packages hangover-wine,
# hangover-wowbox64, hangover-libarm64ecfex, and hangover-libwow64fex). MTW, SS2 and the other
# projects depend on it: do not upgrade, downgrade, reconfigure or remove it (AGENTS.md rule 10).
TRACK=hangover
TRACK_VERSION=11.16
# Full paths, so another Wine earlier in PATH (for example Pi-Apps' in /usr/local/bin) is never
# used. A private copy in ~/ssrw/hangover wins if one is ever unpacked there.
if [ -z "${HANGOVER_ROOT:-}" ]; then
  if [ -x "$HOME/ssrw/hangover/usr/bin/wine" ]; then HANGOVER_ROOT=$HOME/ssrw/hangover/usr; else HANGOVER_ROOT=/usr; fi
fi
WINE_CMD=$HANGOVER_ROOT/bin/wine
WINESERVER_CMD=$HANGOVER_ROOT/bin/wineserver
# This project's own prefix. Never point this at ~/mtw/prefixes or ~/ss2/prefixes.
WINEPREFIX=$HOME/ssrw/prefixes/hangover
WINEARCH=win64
# i386 emulator back-end: FEX. Under Hangover's default WowBox64 saving hangs forever in this
# engine (SS2 experiments 13-17; Resource War saves fine under FEX, SS2 experiment 20).
# An HODLL already in the environment wins.
HODLL=${HODLL:-libwow64fex.dll}
