# Hangover 11.16 (native ARM64 Wine with x86 emulator DLLs), installed system-wide by setup.sh
# (packages hangover-wine and hangover-wowbox64). A private copy in <game home>/hangover/usr wins
# if one is ever unpacked there.
TRACK=hangover
TRACK_VERSION=11.16
if [ -z "${HANGOVER_ROOT:-}" ]; then
  if [ -x "${CIV3_HOME:-$HOME/civ3}/hangover/usr/bin/wine" ]; then HANGOVER_ROOT=${CIV3_HOME:-$HOME/civ3}/hangover/usr; else HANGOVER_ROOT=/usr; fi
fi
# Full paths, so another Wine earlier in PATH is never used.
WINE_CMD=$HANGOVER_ROOT/bin/wine
WINESERVER_CMD=$HANGOVER_ROOT/bin/wineserver
# The game's own prefix.
WINEPREFIX=${CIV3_HOME:-$HOME/civ3}/prefixes/hangover
WINEARCH=win64
# x86 back-end: WowBox64 (faster than FEX for this game; saving and loading work). play.sh sets it.
HODLL=${HODLL:-wowbox64.dll}
